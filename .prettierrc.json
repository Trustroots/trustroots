{
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": [
        "modules/*/server/**/*.mts",
        "scripts/ci/**/*.mts",
        "config/lib/**/*.mts"
      ],
      "options": { "parser": "babel-ts" }
    }
  ]
}
