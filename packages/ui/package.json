{
  "name": "@trustroots/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test:stories": "vitest run"
  },
  "exports": {
    "./globals.css": "./src/globals.css",
    "./Button": "./src/components/Button.tsx",
    "./ButtonGroup": "./src/components/ButtonGroup.tsx",
    "./Alert": "./src/components/Alert.tsx",
    "./Badge": "./src/components/Badge.tsx",
    "./Spinner": "./src/components/Spinner.tsx",
    "./intent": "./src/lib/intent.ts"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-vitest": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.64.1",
    "storybook": "10.6.5",
    "vitest": "5.0.5"
  }
}
