{
  "extends": "../../tooling/tsconfig/base.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.tsx"]
}
