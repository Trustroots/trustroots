{
  "name": "@trustroots/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client/*": "./client/*",
    "./shared/*": "./shared/*"
  },
  "scripts": {
    "lint": "eslint --ext .js,.mjs,.mts,.cjs,.cts,.ts,.tsx .",
    "test:client": "node ../../scripts/test-module.cts client core",
    "test:server": "node ../../scripts/test-module.cts server core"
  },
  "dependencies": {
    "@trustroots/admin": "workspace:*",
    "@trustroots/contacts": "workspace:*",
    "@trustroots/experiences": "workspace:*",
    "@trustroots/messages": "workspace:*",
    "@trustroots/offers": "workspace:*",
    "@trustroots/pages": "workspace:*",
    "@trustroots/search": "workspace:*",
    "@trustroots/statistics": "workspace:*",
    "@trustroots/support": "workspace:*",
    "@trustroots/tribes": "workspace:*",
    "@trustroots/users": "workspace:*"
  }
}
