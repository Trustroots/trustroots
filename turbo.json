{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    "oxlint.config.ts",
    "oxfmt.config.ts",
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "tooling/tsconfig/**",
    "vite.config.mts",
    "vitest.client.config.mts",
    "config/**",
    "testutils/**"
  ],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "test:client": {
      "cache": false
    },
    "test:server": {
      "cache": false
    }
  }
}
