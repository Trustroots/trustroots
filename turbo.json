{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalDependencies": [
    "eslint.config.cts",
    "eslint.config.cjs",
    "package.json",
    "pnpm-lock.yaml",
    "tsconfig*.json",
    "babel.config.cts",
    "jest.config.cjs",
    "jest/**",
    "config/**",
    "testutils/**"
  ],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "test:client": {
      "cache": false
    },
    "test:server": {
      "cache": false
    }
  }
}
