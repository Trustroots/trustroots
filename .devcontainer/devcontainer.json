{
  "name": "Trustroots",
  "dockerComposeFile": ["docker-compose.yml"],
  "service": "dev",
  "workspaceFolder": "/home/app/trustroots",
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  "postCreateCommand": "pnpm run check-environment",
  "postStartCommand": "pnpm run check-environment",
  "portsAttributes": {
    "3000": {
      "label": "Vite dev server",
      "onAutoForward": "ignore"
    },
    "3001": {
      "label": "Express API/server",
      "onAutoForward": "ignore"
    },
    "8025": {
      "label": "Mailpit web UI",
      "onAutoForward": "ignore"
    },
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "ignore"
    },
    "35729": {
      "label": "LiveReload",
      "onAutoForward": "ignore"
    },
    "5858": {
      "label": "Node server inspector",
      "onAutoForward": "ignore"
    },
    "5859": {
      "label": "Node worker inspector",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "eslint.workingDirectories": [
          {
            "mode": "auto"
          }
        ]
      }
    }
  }
}
