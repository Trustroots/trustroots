{
  "name": "trustroots",
  "description": "Trustroots.org",
  "version": "0.3.3",
  "author": "https://www.trustroots.org/foundation",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Trustroots/trustroots"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=11.18.0 <12.0.0",
    "mongodb": ">=3.6 <=4.4"
  },
  "packageManager": "pnpm@11.18.0",
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "check:links": "node scripts/ci/check-internal-links.mjs",
    "test:links": "node --test scripts/ci/check-internal-links.test.mjs",
    "agenda-maintenance": "node ./bin/db-maintenance/archive-done-agenda-jobs.mjs",
    "build": "pnpm run clean:public && pnpm run build:generate-circle-images && pnpm run build:webpack",
    "build:generate-circle-images": "NODE_ENV=production pnpm run generate-circle-images",
    "build:webpack": "NODE_ENV=production pnpm run webpack",
    "cleanup:historical-spam": "node ./bin/db-maintenance/purge-historical-spam-accounts.mjs",
    "build:tarball": "pnpm run build && rm -fr trustroots.tar.gz && touch trustroots.tar.gz && tar --exclude=trustroots.tar.gz --exclude-vcs -czf trustroots.tar.gz .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:client",
    "check-environment": "pnpm run install-dependencies && pnpm exec check-node-version --package && pnpm run ensure-config-exists && pnpm run ensure-uploads-dir-exists",
    "clean:public": "rm -fr ./public/dist ./public/assets",
    "dashboard:jobs": "agendash --db=mongodb://localhost/trustroots-dev --collection=agendaJobs --port=1081",
    "distclean": "rm -fr ./node_modules && rm -fr trustroots.tar.gz && pnpm run clean:public",
    "dropdb": "node ./bin/db-drop.mjs",
    "ensure-config-exists": "node ./bin/ensure-config-exists.mjs",
    "ensure-uploads-dir-exists": "node ./bin/ensure-uploads-dir-exists.mjs",
    "generate-circle-images": "node ./bin/generate-circle-images.mjs",
    "i18n:extract": "babel --config-file ./babel.config.i18n.cjs -o /dev/null 'modules/**/*.{js,ts,tsx}'",
    "i18n:fix-weblate": "node ./bin/fix-weblate.mjs public/locales/en/*.json",
    "i18n:check-placeholders": "node ./bin/check-i18n-placeholders.mjs",
    "i18n": "pnpm run i18n:extract && pnpm run i18n:fix-weblate",
    "install-dependencies": "node ./bin/install-deps.mjs",
    "lint:watch": "nodemon --watch modules --watch config --watch bin --watch migrations --watch eslint.config.cjs --ext js,mjs,cjs,ts,tsx --exec 'pnpm run lint --cache --quiet'",
    "lint:modules": "node ./scripts/ci/check-module-graph.mts",
    "lint:modules:test": "node --test ./scripts/ci/check-module-graph.test.mts",
    "modules:update-baseline": "node ./scripts/ci/check-module-graph.mts --update",
    "lint": "eslint --ext .js,.mjs,.mts,.cjs,.ts,.tsx .",
    "lint:report": "eslint --ext .js,.mjs,.mts,.ts,.tsx --output-file ./eslint_report.json --format json .",
    "migrate-down": "migrate down",
    "migrate": "migrate up",
    "reformat-files": "prettier --ignore-path .prettierignore --write",
    "preseed": "pnpm run check-environment",
    "prestart": "pnpm run check-environment",
    "seed:experiences": "node ./bin/fillTestData/Experiences.mjs 10 0.8",
    "seed:messages": "node ./bin/fillTestData/Messages.mjs",
    "seed:tribes": "node ./bin/fillTestData/Tribes.mjs",
    "seed:users": "node ./bin/fillTestData/Users.mjs",
    "seed": "pnpm run seed:tribes 100 && pnpm run seed:users 1000 --userNames admin1 admin2 admin3 && pnpm run seed:messages 2000 10 && pnpm run seed:experiences --re-create",
    "seed:e2e": "NODE_ENV=test DB_1_PORT_27017_TCP_ADDR=127.0.0.1 TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/e2e/seed.js",
    "start:develop": "pnpm run generate-circle-images && NODE_ENV=development node ./scripts/start-with-nodemon.js",
    "start:docker": "pnpm run prestart && concurrently --raw --kill-others --kill-others-on-fail 'pnpm:lint:watch' 'pnpm:start:develop' 'pnpm:webpack:server' 'pnpm:start:worker'",
    "start:prod": "NODE_ENV=production node server.js",
    "start:worker:prod": "NODE_ENV=production node worker.js",
    "start:worker": "NODE_ENV=development node ./scripts/start-with-nodemon.js worker",
    "start": "concurrently --raw --kill-others --kill-others-on-fail 'pnpm:lint:watch' 'pnpm:start:develop' 'pnpm:webpack:server' 'pnpm:start:worker'",
    "test:client:watch": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.js' jest --watch --no-watchman",
    "test:boundaries": "mocha modules/core/tests/server/api-input.server.tests.js modules/core/tests/server/csrf-protection.server.tests.js",
    "test:client": "BROWSERSLIST_IGNORE_OLD_DATA=1 NODE_OPTIONS='--require ./jest/jest.hide-canvas.js' jest --no-watchman --silent --maxWorkers=50%",
    "test:coverage:client": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.js' jest --coverage --runInBand --no-watchman",
    "test:coverage:client:ci": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.js' jest --coverage --maxWorkers=50% --no-watchman",
    "test:coverage:server": "NODE_OPTIONS='--import ./scripts/coverage/native-esm.mjs' nyc --nycrc-path .nycrc-server pnpm run test:server",
    "test:coverage:server:codex": "NODE_OPTIONS='--import ./scripts/coverage/native-esm.mjs' nyc --nycrc-path .nycrc-server pnpm run test:server:codex",
    "test:coverage": "pnpm run test:coverage:client && pnpm run test:coverage:server",
    "coverage:check": "node ./scripts/coverage/check-coverage.js",
    "coverage:pr-summary": "node ./scripts/coverage/generate-pr-summary.js",
    "coverage:report": "node ./scripts/coverage/generate-report.js",
    "coverage:update-baseline": "node ./scripts/coverage/check-coverage.js --update",
    "build:e2e": "./scripts/e2e/build-web.sh",
    "start:e2e:api": "NODE_ENV=test PORT=${TRUSTROOTS_E2E_API_PORT:-4301} DB_1_PORT_27017_TCP_ADDR=${DB_1_PORT_27017_TCP_ADDR:-127.0.0.1} TRUSTROOTS_SKIP_LOCAL_CONFIG=true TRUSTROOTS_AVATAR_PROCESSOR_FALLBACK=true TRUSTROOTS_FILE_MAGIC_FALLBACK=true node server.js",
    "start:e2e:web": "NODE_ENV=test PORT=${TRUSTROOTS_E2E_WEB_PORT:-4300} TRUSTROOTS_API_URL=http://${TRUSTROOTS_E2E_HOST:-127.0.0.1}:${TRUSTROOTS_E2E_API_PORT:-4301} TRUSTROOTS_SKIP_LOCAL_CONFIG=true pnpm run webpack:server",
    "test:all": "./scripts/test-all.sh",
    "test:codex": "pnpm run test:client && pnpm run test:server:codex",
    "test:docker": "./scripts/test-all.sh",
    "test:e2e": "./scripts/e2e/test-e2e.sh",
    "test:e2e:headed": "./scripts/e2e/test-e2e.sh --headed",
    "test:e2e:ui": "./scripts/e2e/test-e2e.sh --ui",
    "test:server:codex": "TRUSTROOTS_SKIP_LOCAL_CONFIG=true ./scripts/codex/test-server.sh",
    "test:server:files": "node ./scripts/test-server-files.js",
    "test:server:watch": "pnpm run check-environment && NODE_ENV=test nodemon --watch modules --watch config --watch migrations --watch server.js --ext js,mjs,mts --ignore 'modules/*/client/**' --ignore 'modules/*/tests/client/**' --exec 'node ./scripts/test-server.js'",
    "test:server:parallel": "NODE_ENV=test node ./scripts/test-server-parallel.js",
    "test:coverage:server:parallel": "NODE_OPTIONS='--import ./scripts/coverage/native-esm.mjs' nyc --nycrc-path .nycrc-server pnpm run test:server:parallel",
    "test:server": "NODE_ENV=test node ./scripts/test-server.js",
    "test": "pnpm run check-environment && pnpm run lint && pnpm run test:client && pnpm run test:server",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.contracts.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.fixtures.json && tsc --noEmit -p tsconfig.scripts.json",
    "webpack": "webpack --config config/webpack/webpack.config.js",
    "webpack:server": "webpack serve --hot --config config/webpack/webpack.config.js",
    "ensure-indexes": "node ./bin/db-maintenance/ensure-indexes.mjs",
    "ensure-circle-discovery-indexes": "node ./bin/db-maintenance/ensure-circle-discovery-indexes.mjs",
    "prepare": "husky install",
    "vite:server": "NODE_ENV=development vite --config vite.config.mjs",
    "build:vite": "NODE_ENV=production vite build --config vite.config.mjs",
    "start:vite": "TRUSTROOTS_VITE_DEV_SERVER=true concurrently --raw --kill-others --kill-others-on-fail 'npm:lint:watch' 'npm:start:develop' 'npm:vite:server' 'npm:start:worker'",
    "test:vite:production": "NODE_ENV=production TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/vite/smoke-shell.js",
    "test:vite:development": "NODE_ENV=development TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/vite/smoke-shell.js"
  },
  "dependencies": {
    "@tanstack/react-router": "1.120.5",
    "agenda": "4.4.0",
    "akismet-api": "5.3.0",
    "async": "2.6.4",
    "autolinker": "4.1.5",
    "axios": "1.20.0",
    "basic-auth": "2.0.1",
    "bootstrap": "5.3.8",
    "check-node-version": "4.2.1",
    "classnames": "2.5.1",
    "compression": "1.8.2",
    "connect-mongo": "4.6.0",
    "cookie-parser": "1.4.7",
    "core-js": "3.49.0",
    "expect-ct": "1.0.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "file-type": "22.1.1",
    "glob": "7.2.3",
    "gm": "1.25.1",
    "he": "1.2.0",
    "helmet": "8.3.0",
    "html-to-text": "8.2.1",
    "i18next": "20.6.1",
    "i18next-browser-languagedetector": "6.1.5",
    "i18next-http-backend": "4.0.2",
    "influx": "5.9.3",
    "juice": "8.1.0",
    "leaflet": "1.7.1",
    "lodash": "4.18.1",
    "mapbox-gl": "1.13.2",
    "medium-editor": "5.23.3",
    "migrate": "2.1.0",
    "moment": "2.31.0",
    "mongodb": "4.17.2",
    "mongoose": "6.13.11",
    "mongoose-paginate": "5.0.3",
    "mongoose-url-slugs": "1.0.2",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "nodemailer": "10.0.13",
    "nostr-tools": "2.25.2",
    "nunjucks": "3.2.4",
    "open-location-code": "1.0.3",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "process": "0.11.10",
    "prop-types": "15.8.1",
    "qs": "6.16.0",
    "querystring-es3": "0.2.1",
    "react": "18.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "18.3.1",
    "react-i18next": "11.15.1",
    "react-map-gl": "5.3.19",
    "react-query": "3.39.3",
    "react-responsive": "8.2.0",
    "react-select": "5.10.2",
    "sanitize-html": "2.17.7",
    "semver": "7.8.5",
    "serve-favicon": "2.5.1",
    "speakingurl": "14.0.1",
    "styled-components": "6.5.3",
    "supercluster": "7.1.5",
    "url": "0.11.4",
    "use-debounce": "10.1.1",
    "use-local-storage-state": "20.0.0",
    "validator": "13.15.35",
    "web-push": "3.6.7",
    "winston": "3.19.0",
    "winston-papertrail-transport": "1.0.9",
    "zod": "4.4.3"
  },
