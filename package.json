{
  "name": "trustroots",
  "description": "Trustroots.org",
  "version": "0.3.3",
  "author": "https://www.trustroots.org/foundation",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Trustroots/trustroots"
  },
  "engines": {
    "node": ">=24.22.1 <25.0.0",
    "pnpm": ">=11.18.0 <12.0.0",
    "mongodb": ">=3.6 <=4.4"
  },
  "packageManager": "pnpm@11.18.0",
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "scripts": {
    "check:links": "node scripts/ci/check-internal-links.mts",
    "test:links": "node --test scripts/ci/check-internal-links.test.mts",
    "agenda-maintenance": "node ./bin/db-maintenance/archive-done-agenda-jobs.mts",
    "support:prepare-zendesk-statuses": "node ./bin/db-maintenance/prepare-zendesk-statuses.mts",
    "support:migrate-inbox": "node ./bin/db-maintenance/migrate-support-inbox.mts",
    "build": "pnpm run clean:public && pnpm run build:generate-circle-images && pnpm run build:vite",
    "build:generate-circle-images": "NODE_ENV=production pnpm run generate-circle-images",
    "cleanup:historical-spam": "node ./bin/db-maintenance/purge-historical-spam-accounts.mts",
    "build:tarball": "pnpm run build && rm -fr trustroots.tar.gz && touch trustroots.tar.gz && tar --exclude=trustroots.tar.gz --exclude-vcs -czf trustroots.tar.gz .",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:client && pnpm run test:config && pnpm run test:nostranslation && pnpm run test:promise-flows",
    "test:promise-flows": "node --test scripts/native-promise-jobs.test.cjs",
    "check-environment": "pnpm run install-dependencies && pnpm exec check-node-version --package && pnpm run ensure-config-exists && pnpm run ensure-uploads-dir-exists",
    "clean:public": "rm -fr ./public/dist ./public/assets",
    "dashboard:jobs": "node ./bin/dashboard-jobs.mts --db=mongodb://localhost/trustroots-dev --collection=agendaJobs --port=1081",
    "distclean": "rm -fr ./node_modules && rm -fr trustroots.tar.gz && pnpm run clean:public",
    "dropdb": "node ./bin/db-drop.mts",
    "ensure-config-exists": "node ./bin/ensure-config-exists.mts",
    "ensure-uploads-dir-exists": "node ./bin/ensure-uploads-dir-exists.mts",
    "generate-circle-images": "node ./bin/generate-circle-images.mts",
    "i18n:extract": "babel --config-file ./tooling/babel/i18n.config.cjs -o /dev/null 'modules/**/*.{js,ts,tsx}' 'layers/shell/**/*.{js,ts,tsx}'",
    "i18n:fix-weblate": "node ./bin/fix-weblate.mts public/locales/en/*.json",
    "i18n:check-placeholders": "node ./bin/check-i18n-placeholders.mts",
    "i18n": "pnpm run i18n:extract && pnpm run i18n:fix-weblate",
    "install-dependencies": "node ./bin/install-deps.mts",
    "lint:watch": "nodemon --watch modules --watch config --watch bin --watch migrations --watch eslint.config.cjs --ext js,mjs,mts,cjs,cts,ts,tsx --exec 'pnpm run lint --cache --quiet'",
    "lint:modules": "node ./scripts/ci/check-module-graph.mts",
    "lint:modules:test": "node --test ./scripts/ci/check-module-graph.test.mts",
    "lint:packages": "node ./scripts/ci/check-module-packages.mts",
    "lint:packages:test": "node --test ./scripts/ci/check-module-packages.test.mts",
    "lint:boundaries": "node ./tooling/guards/check-package-boundaries.mts && node ./tooling/guards/check-module-boundaries.mts && node ./tooling/guards/check-module-runtime-boundaries.mts",
    "lint:boundaries:test": "node --test ./tooling/guards/check-package-boundaries.test.mts ./tooling/guards/check-module-boundaries.test.mts ./tooling/guards/check-module-runtime-boundaries.test.mts",
    "check:affected": "node ./scripts/check-affected.mts",
    "test:affected": "node --test ./scripts/check-affected.test.mts",
    "modules:update-baseline": "node ./scripts/ci/check-module-graph.mts --update",
    "modules:update-packages": "node ./scripts/ci/check-module-packages.mts --update",
    "lint": "pnpm run lint:boundaries && pnpm run lint:boundaries:test && eslint --ext .js,.mjs,.mts,.cjs,.cts,.ts,.tsx . && node --test scripts/ci/eslint-accessibility.test.mts",
    "lint:report": "eslint --ext .js,.mjs,.mts,.cjs,.cts,.ts,.tsx --output-file ./eslint_report.json --format json .",
    "migrate-down": "migrate down",
    "migrate": "migrate up",
    "mongo:migration": "node ./scripts/db-migration/mongodb-upgrade.mts",
    "reformat-files": "prettier --ignore-path .prettierignore --write",
    "preseed": "pnpm run check-environment",
    "prestart": "pnpm run check-environment",
    "seed:experiences": "node ./bin/fillTestData/Experiences.mts 10 0.8",
    "seed:messages": "node ./bin/fillTestData/Messages.mts",
    "seed:tribes": "node ./bin/fillTestData/Tribes.mts",
    "seed:users": "node ./bin/fillTestData/Users.mts",
    "seed": "pnpm run seed:tribes 100 && pnpm run seed:users 1000 --userNames admin1 admin2 admin3 && pnpm run seed:messages 2000 10 && pnpm run seed:experiences --re-create",
    "seed:e2e": "NODE_ENV=test DB_1_PORT_27017_TCP_ADDR=127.0.0.1 TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/e2e/seed.js",
    "start:develop": "pnpm run generate-circle-images && NODE_ENV=development node ./scripts/start-with-nodemon.cts",
    "start:docker": "pnpm run start",
    "start:prod": "NODE_ENV=production node server.js",
    "start:worker:prod": "NODE_ENV=production node worker.js",
    "start:worker": "NODE_ENV=development node ./scripts/start-with-nodemon.cts worker",
    "start": "TRUSTROOTS_VITE_DEV_SERVER=true concurrently --raw --kill-others --kill-others-on-fail 'pnpm:lint:watch' 'pnpm:start:develop' 'pnpm:vite:server' 'pnpm:start:worker'",
    "test:client:watch": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.cts' jest --watch --no-watchman",
    "test:boundaries": "SERVER_TEST_SKIP_DATABASE=true SERVER_TEST_FILES=modules/core/tests/server/api-input.server.tests.cts,modules/core/tests/server/csrf-protection.server.tests.cts NODE_ENV=test node ./scripts/test-server.cts",
    "test:content": "pnpm run test:client --runTestsByPath modules/core/tests/client/components/RichText.tests.tsx modules/core/tests/client/components/TrEditor.integration.tests.tsx modules/core/tests/client/utils/filters.tests.ts",
    "test:client": "BROWSERSLIST_IGNORE_OLD_DATA=1 NODE_OPTIONS='--require ./jest/jest.hide-canvas.cts' jest --no-watchman --silent --maxWorkers=50%",
    "test:coverage:client": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.cts' jest --coverage --runInBand --no-watchman",
    "test:coverage:client:ci": "NODE_OPTIONS='--require ./jest/jest.hide-canvas.cts' jest --coverage --maxWorkers=50% --no-watchman",
    "test:coverage:server": "SERVER_TEST_COVERAGE=true pnpm run test:server",
    "test:coverage:server:codex": "SERVER_TEST_COVERAGE=true pnpm run test:server:codex",
    "test:coverage": "pnpm run test:coverage:client && pnpm run test:coverage:server",
    "coverage:check": "node ./scripts/coverage/check-coverage.cts",
    "coverage:pr-summary": "node ./scripts/coverage/generate-pr-summary.cts",
    "coverage:report": "node ./scripts/coverage/generate-report.cts",
    "coverage:update-baseline": "node ./scripts/coverage/check-coverage.cts --update",
    "build:e2e": "./scripts/e2e/build-web.sh",
    "start:e2e:api": "NODE_ENV=test PORT=${TRUSTROOTS_E2E_API_PORT:-4301} DB_1_PORT_27017_TCP_ADDR=${DB_1_PORT_27017_TCP_ADDR:-127.0.0.1} TRUSTROOTS_SKIP_LOCAL_CONFIG=true TRUSTROOTS_AVATAR_PROCESSOR_FALLBACK=true TRUSTROOTS_FILE_MAGIC_FALLBACK=true node server.js",
    "test:all": "./scripts/test-all.sh",
    "test:codex": "pnpm run test:client && pnpm run test:server:codex",
    "test:docker": "./scripts/test-all.sh",
    "test:e2e": "./scripts/e2e/test-e2e.sh",
    "test:e2e:headed": "./scripts/e2e/test-e2e.sh --headed",
    "test:e2e:ui": "./scripts/e2e/test-e2e.sh --ui",
    "test:server:codex": "TRUSTROOTS_SKIP_LOCAL_CONFIG=true ./scripts/codex/test-server.sh",
    "test:server:files": "node ./scripts/test-server-files.cts",
    "test:record-access": "node ./scripts/ci/test-record-access.mts",
    "test:server:watch": "pnpm run check-environment && NODE_ENV=test nodemon --watch modules --watch config --watch migrations --watch server.js --ext js,mjs,mts,cts --ignore 'modules/*/client/**' --ignore 'modules/*/tests/client/**' --exec 'node ./scripts/test-server.cts'",
    "test:server:parallel": "NODE_ENV=test node ./scripts/test-server-parallel.cts",
    "test:coverage:server:parallel": "SERVER_TEST_COVERAGE=true pnpm run test:server:parallel",
    "test:server": "NODE_ENV=test node ./scripts/test-server.cts",
    "test": "pnpm run check-environment && pnpm run lint && pnpm run test:client && pnpm run test:server",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tooling/tsconfig/tests.json && tsc --noEmit -p tooling/tsconfig/contracts.json && tsc --noEmit -p tooling/tsconfig/contract-diagnostics.json && tsc --noEmit -p tooling/tsconfig/server.json && tsc --noEmit -p tooling/tsconfig/fixtures.json && tsc --noEmit -p tooling/tsconfig/scripts.json && tsc --noEmit -p tooling/tsconfig/test-harness.json && tsc --noEmit -p tooling/tsconfig/e2e.json && tsc --noEmit -p tooling/tsconfig/server-tests.json && tsc --noEmit -p tooling/tsconfig/config.json && tsc --noEmit -p tooling/tsconfig/docs.json && pnpm run nostranslation:typecheck",
    "ensure-indexes": "node ./bin/db-maintenance/ensure-indexes.mts",
    "ensure-circle-discovery-indexes": "node ./bin/db-maintenance/ensure-circle-discovery-indexes.mts",
    "prepare": "husky install",
    "vite:server": "NODE_ENV=development vite --config vite.config.mts",
    "build:vite": "NODE_ENV=production vite build --config vite.config.mts",
    "start:vite": "pnpm run start",
    "test:client:resolution": "node --test config/client/import-resolution.test.mjs",
    "test:vite:rtl": "node --test config/vite/rtl-stylesheet.test.mts config/vite/dev-server-scripts.test.mts config/client/import-resolution.test.mjs",
    "test:vite:production": "NODE_ENV=production TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/vite/smoke-shell.cts",
    "test:vite:development": "NODE_ENV=development TRUSTROOTS_SKIP_LOCAL_CONFIG=true node ./scripts/vite/smoke-shell.cts",
    "test:config": "node --test config/config.test.mts config/lib/start-worker.test.mts scripts/db-migration/mongodb-upgrade.test.mts",
    "build:docs": "node scripts/ci/build-docs-scripts.mts",
    "test:docs": "pnpm run build:docs && node --test scripts/ci/latest-apk.test.mts scripts/ci/zapstore-publisher.test.mts && playwright test --config scripts/ci/docs-playwright.config.mts",
    "nostranslation:dev": "vite --config apps/nostranslation/vite.config.mts",
    "nostranslation:build": "vite build --config apps/nostranslation/vite.config.mts",
    "nostranslation:start": "node apps/nostranslation/server/start.mts",
    "nostranslation:generate": "node apps/nostranslation/server/worker.mts",
    "nostranslation:check-translations": "node apps/nostranslation/server/check.mts",
    "nostranslation:typecheck": "tsc --noEmit -p apps/nostranslation/tsconfig.json",
    "test:nostranslation": "jest --config apps/nostranslation/jest.config.cjs --runInBand --no-watchman",
    "test:nostranslation:e2e": "playwright test --config apps/nostranslation/playwright.config.mts",
    "ensure-radio-circle": "node ./bin/db-maintenance/ensure-radio-circle.mts",
    "knip": "BRAVE_EXECUTABLE_PATH=knip knip"
  },
  "dependencies": {
    "@agendajs/mongo-backend": "4.0.3",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-router": "1.170.46",
    "@trustroots/logger": "workspace:*",
    "@trustroots/ui": "workspace:*",
    "agenda": "6.2.6",
    "autolinker": "4.1.5",
    "axios": "1.21.0",
    "basic-auth": "3.0.0",
    "bootstrap": "5.3.8",
    "check-node-version": "4.2.1",
    "classnames": "2.5.1",
    "compression": "1.8.2",
    "connect-mongo": "6.0.0",
    "core-js": "3.51.0",
    "dompurify": "3.4.17",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "file-type": "22.3.0",
    "gm": "1.25.1",
    "he": "2.0.0",
    "helmet": "8.3.0",
    "html-to-text": "10.0.1",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "i18next-http-backend": "4.0.6",
    "imapflow": "2.10.0",
    "influx": "5.12.0",
    "ipaddr.js": "2.5.0",
    "juice": "12.2.1",
    "leaflet": "1.9.4",
    "lodash": "4.18.1",
    "mailparser": "3.14.1",
    "mapbox-gl": "3.34.1",
    "maxmind": "5.0.7",
    "medium-editor": "5.23.3",
    "migrate": "2.1.0",
    "moment": "2.31.0",
    "mongodb": "7.7.0",
    "mongoose": "9.11.4",
    "morgan": "1.12.1",
    "multer": "2.5.0",
    "nodemailer": "10.3.1",
    "nostr-tools": "2.25.4",
    "nunjucks": "3.2.4",
    "open-location-code": "1.0.3",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "process": "0.11.10",
    "qrcode": "1.5.4",
    "qs": "catalog:",
    "react": "19.3.1",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.9",
    "react-map-gl": "8.1.3",
    "react-select": "5.10.2",
    "sanitize-html": "2.18.1",
    "semver": "7.8.5",
    "serve-favicon": "2.5.1",
    "sharp": "0.35.5",
    "speakingurl": "14.0.1",
    "styled-components": "6.6.0",
    "supercluster": "9.1.0",
    "use-local-storage-state": "20.0.0",
    "validator": "13.15.35",
    "web-push": "3.6.7",
    "winston": "3.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/cli": "7.29.7",
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/express": "5.0.6",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/jest": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/lodash": "4.17.27",
    "@types/medium-editor": "5.0.8",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sinon": "22.0.2",
    "@types/supertest": "7.2.1",
    "@types/yargs": "17.0.35",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@wordpress/browserslist-config": "7.0.0",
    "agendash": "8.2.4",
    "autoprefixer": "10.6.2",
    "babel-jest": "30.5.2",
    "babel-plugin-i18next-extract": "1.1.0",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest-dom": "5.10.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-testing-library": "7.16.2",
    "husky": "9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "js-yaml": "5.5.0",
    "knip": "6.44.0",
    "less": "4.9.1",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "rtlcss": "4.3.0",
    "should": "13.2.3",
    "sinon": "22.1.0",
    "supertest": "6.1.6",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "v8-to-istanbul": "9.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yargs": "18.2.0"
  },
  "bugs": {
    "url": "https://github.com/Trustroots/trustroots/issues"
  },
  "license": "AGPL",
  "lint-staged": {
    "*.{js,mjs,mts,cjs,cts,ts,tsx}": [
      "pnpm run reformat-files",
      "eslint"
    ],
    "*.{json,md,html,less,yml}": [
      "pnpm run reformat-files"
    ]
  },
  "type": "module"
}
