{
  "extends": "./tooling/tsconfig/base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"],
      "modules/*": ["./modules/*"]
    },
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "config/client/i18n.ts",
    "config/vite/load-module-styles.ts",
    "config/vite/load-styles.ts",
    "config/vite/react-main.tsx",
    "layers/shell/**/*.ts",
    "layers/shell/**/*.tsx",
    "packages/ui/**/*.tsx",
    "modules/*/client/**/*.ts",
    "modules/*/client/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
