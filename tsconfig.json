{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedSideEffectImports": false,
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"],
      "modules/*": ["./modules/*"]
    },
    "types": [],
    "resolveJsonModule": true
  },
  "include": ["modules/*/client/**/*.ts", "modules/*/client/**/*.tsx"],
  "exclude": ["node_modules"]
}
