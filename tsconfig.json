{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"],
      "modules/*": ["./modules/*"],
      "nostr-tools/nip46": ["./node_modules/nostr-tools/lib/types/nip46.d.ts"]
    },
    "types": ["vite/client"],
    "resolveJsonModule": true
  },
  "include": [
    "config/client/i18n.ts",
    "config/vite/load-module-styles.ts",
    "config/vite/load-styles.ts",
    "config/vite/react-main.tsx",
    "modules/*/client/**/*.ts",
    "modules/*/client/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
