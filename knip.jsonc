// Run with `pnpm knip`. It is a report, not a gate: it stays out of
// `pnpm check` and CI.
//
// The script sets BRAVE_EXECUTABLE_PATH because Knip loads
// playwright.windows-wheel.config.cjs (named in a workflow), which throws
// without it.
//
// Knip can't see two kinds of export use, so they carry a JSDoc tag that
// excludes them from the report:
//
// - @commonjs: CommonJS code reads it. `require()` of an ES module returns
//   its 'module.exports' export when there is one, and Knip doesn't follow
//   member access on a whole `require()` result
//   (`const utils = require('./x.mts'); utils.foo()`), the usual style of
//   the .cts server tests.
// - @esmNamed: a named export that mirrors a member of the module's default
//   object. The runtime-platform spec keeps these for ES module consumers
//   and the esm-*.server.tests.cts files check them, but nothing imports
//   them by name yet.
{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "tags": ["-commonjs", "-esmNamed"],
  "workspaces": {
    ".": {
      "entry": [
        // server.js and worker.js (PM2, start:prod) only import these. Knip
        // would map server.mjs back to server.js because they share a
        // basename, and then never walk the server or worker graph.
        "server.mjs",
        "worker.mjs",
        // Command-line tools run by path from package scripts, shell scripts,
        // Docker, CI and by hand.
        "bin/**/*.mts",
        "scripts/**/*.{js,cts,mts,cjs}",
        "tooling/guards/*.mts",
        "config/languages/generate.cts",
        // build-docs-scripts.mts compiles these into docs/assets/js, which
        // the GitHub Pages docs load with <script> tags.
        "docs/src/*.mts",
        // Copied or mounted over config/env/local.js, which config/config.mts
        // loads by path.
        "config/env/local.sample.js",
        ".devcontainer/local.js",
        "deploy/files/secrets/*.local.js",
        // TypeScript uses this sidecar for the types of logger.mjs.
        "config/lib/logger.d.mts",
        // Playwright's setup project matches this with a regular expression,
        // which Knip can't expand.
        "tests/e2e/setup/auth.setup.mts",
        // From 2017 until #2769 the app registered /sw.js with scope / on
        // every visit, and nginx serves public/ directly. Returning browsers
        // still have that empty worker and fetch /sw.js to check for updates,
        // so it must stay although nothing imports it.
        "public/sw.js",
      ],
      // Include stylesheets so Knip follows their imports, such as
      // tailwind.css importing tailwindcss.
      "project": ["**/*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,css,less}"],
      "vitest": {
        // scripts/test-server.cts passes this config to Vitest.
        "config": ["vitest.server.config.mts"],
      },
      "pm2": {
        // PM2 starts server.js and worker.js from these in production.
        "config": ["server-pm2.json", "worker-pm2.json"],
      },
      "babel": {
        // i18n:extract passes the second with --config-file.
        "config": ["babel.config.cts", "tooling/babel/i18n.config.cjs"],
      },
      "ignoreDependencies": [
        // eslint.config.cts loads these by name through FlatCompat, which
        // Knip's ESLint plugin can't read.
        "@typescript-eslint/eslint-plugin",
        "@typescript-eslint/parser",
        "eslint-config-prettier",
        "eslint-plugin-jest-dom",
        "eslint-plugin-jsx-a11y",
        "eslint-plugin-prettier",
        "eslint-plugin-react",
        "eslint-plugin-testing-library",
        // The browserslist field in package.json extends this.
        "@wordpress/browserslist-config",
        // Babel's preset-env injects core-js imports (useBuiltIns: usage).
        "core-js",
        // vite.config.mts injects process/browser into the client bundle.
        "process",
        // scripts/check-affected.mts runs `pnpm exec turbo`.
        "turbo",
      ],
    },
    // A standalone tool with its own package.json, outside the pnpm
    // workspace and installed by hand when it is used.
    "scripts/mass-email": {
      "entry": ["*.cts"],
    },
    "modules/*": {
      "entry": [
        // config/assets/default.mts globs these and config/lib loads them by
        // path at startup.
        "server/models/**/*.{mjs,mts}",
        "server/routes/**/*.{mjs,mts}",
        "server/config/*.{mjs,mts}",
        "server/policies/*.{mjs,mts}",
        // The root Jest and Vitest configs run these, but Knip attributes a
        // plugin's entries to the workspace that holds the config.
        "tests/client/**/*.tests.{js,jsx,ts,tsx}",
        "tests/server/**/*.{js,cts,mts}",
        // Type-level contract checks that only `tsc -p` compiles (see
        // tooling/tsconfig/contracts.json,
        // tooling/tsconfig/contract-diagnostics.json and tooling/tsconfig/tests.json).
        "tests/fixtures/*contract*.mts",
        "tests/client/**/*contract*.{ts,mts}",
        // CommonJS adapters that api-payload-native-imports.server.tests.cts
        // requires by path in a child process.
        "server/services/*.server.service.cjs",
      ],
      "project": ["**/*.{js,jsx,ts,tsx,mjs,mts,cjs,cts}"],
      // scripts/ci/check-module-packages.mts writes these from
      // tooling/baselines/module-graph.json so Turborepo knows the module graph.
      // Modules import each other by relative path, not by package name.
      "ignoreDependencies": ["@trustroots/.*"],
    },
    "packages/*": {},
  },
}
