{
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "esModuleInterop": true,
    "lib": ["ES2020"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": [
    "config/lib/**/*.cts",
    "modules/*/server/**/*.ts",
    "modules/*/server/**/*.cts",
    "modules/*/server/**/*.mts"
  ],
  "exclude": ["node_modules", "modules/*/tests/**"]
}
